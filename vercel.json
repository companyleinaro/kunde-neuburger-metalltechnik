{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {"source": "/index.html", "destination": "/", "permanent": true},
    {"source": "/kontakt", "destination": "/kontakt.html", "permanent": true},
    {"source": "/kontakt/(.*)", "destination": "/kontakt.html", "permanent": true},
    {"source": "/leistungen", "destination": "/leistungen.html", "permanent": true},
    {"source": "/leistungen/(.*)", "destination": "/leistungen.html", "permanent": true},
    {"source": "/ueber-uns", "destination": "/ueber-uns.html", "permanent": true},
    {"source": "/ueber-uns/(.*)", "destination": "/ueber-uns.html", "permanent": true},
    {"source": "/projekte", "destination": "/projekte.html", "permanent": true},
    {"source": "/projekte/(.*)", "destination": "/projekte.html", "permanent": true},
    {"source": "/referenzen", "destination": "/projekte.html", "permanent": true},
    {"source": "/referenzen/(.*)", "destination": "/projekte.html", "permanent": true},
    {"source": "/metalltechnik", "destination": "/metalltechnik.html", "permanent": true},
    {"source": "/metalltechnik/(.*)", "destination": "/metalltechnik.html", "permanent": true},
    {"source": "/impressum", "destination": "/impressum.html", "permanent": true},
    {"source": "/impressum/(.*)", "destination": "/impressum.html", "permanent": true},
    {"source": "/datenschutz", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/datenschutz/(.*)", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/datenschutzerklaerung", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/datenschutzerklaerung/(.*)", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/datenschutzerklarung", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/datenschutzerklarung/(.*)", "destination": "/datenschutz.html", "permanent": true},
    {"source": "/home", "destination": "/", "permanent": true},
    {"source": "/home/(.*)", "destination": "/", "permanent": true},
    {"source": "/startseite", "destination": "/", "permanent": true},
    {"source": "/startseite/(.*)", "destination": "/", "permanent": true},
    {"source": "/feed", "destination": "/", "permanent": true},
    {"source": "/feed/(.*)", "destination": "/", "permanent": true},
    {"source": "/comments/feed", "destination": "/", "permanent": true},
    {"source": "/comments/feed/(.*)", "destination": "/", "permanent": true},
    {"source": "/wp-sitemap.xml", "destination": "/sitemap.xml", "permanent": true},
    {"source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
